# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The source .epub itself is never committed (large binary, not needed to
# run the app - only the pipeline needs it, locally, to regenerate content).
*.epub
.local-books/

# Build intermediates from the content pipeline (raw extracted text,
# tokenized word lists, per-section CEFR candidate data) aren't needed to
# run the app and are regenerable from the .epub, so they stay out of git.
# content/*/lessons/ and content/*/manifest.json ARE committed.
content/*/raw/
content/*/tokenized/
content/*/cefr/
content/*/parts-summary.json

# Generated bundle of all lesson content for the standalone build (rebuild
# with `npm run build:standalone`). standalone-dist/index.html - the actual
# single-file deliverable - IS committed.
standalone/content-data.ts
